{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "yarn build && yarn build:backend",
  "outputDirectory": "dist/apps/frontend/browser",
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/apps/backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
