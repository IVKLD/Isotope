{
  "name": "igni-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --port 4200",
    "start:api": "nest start --watch",
    "build": "ng build --configuration production",
    "build:api": "nest build",
    "start:prod": "node dist/apps/api/main.js",
    "preview": "serve -s dist/apps/portfolio/browser -l 4200",
    "watch": "ng build --watch --configuration development",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "audit:metrics": "node scripts/audit-metrics.mjs",
    "audit:metrics:desktop": "node scripts/audit-metrics.mjs --desktop",
    "audit:metrics:all": "node scripts/audit-metrics.mjs --desktop --all-routes && node scripts/audit-metrics.mjs --all-routes"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.1.4",
    "@angular/ssr": "^22.2.0",
    "@lucide/angular": "^1.48.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "highlight.js": "^11.12.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@nestjs/cli": "^12.0.8",
    "@types/express": "^5.0.1",
    "@types/node": "^26.6.5",
    "angular-eslint": "^22.5.0",
    "chrome-launcher": "^1.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "lighthouse": "^13.5.0",
    "nx": "^23.3.0",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
